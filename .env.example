# ============================================================================
# ISTAFA WEDDING — ENVIRONMENT VARIABLES CONFIGURATION
# Configure these variables in Vercel Project Settings -> Environment Variables
# for Development, Preview, and Production environments.
# ============================================================================

# 1. ADMIN AUTHENTICATION (Server-Side Only — Never expose to VITE_ frontend!)
# Configure in Vercel Environment Variables (Development, Preview, Production)
ADMIN_USERNAME="YOUR_ADMIN_USERNAME"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_RANDOM_64_CHAR_SESSION_SECRET"

# 2. PUBLIC APPLICATION URL
# Development: http://localhost:3000
# Preview / Production: https://your-domain.vercel.app
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# 3. PERSISTENT DATABASE & CLOUD STORAGE (Firebase Firestore + Cloud Storage)
# Used across Development, Preview, and Production so uploaded product photos
# and database records persist permanently across deployments.
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0345884091"
VITE_FIREBASE_APP_ID="1:351804012121:web:d87a834b99f438c3362348"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_PUBLIC_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0345884091.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-e924502b-70ff-4f85-bf48-b4a8a84b5499"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0345884091.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="351804012121"

# 4. GEMINI AI API KEY (Optional Server-Side Integration)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
