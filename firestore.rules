rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 3: Reusable Hardened Global Helpers
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'ahhidayat953@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidImageItem(item) {
      return item is map &&
        item.keys().hasAll(['id', 'url', 'isPrimary']) &&
        item.keys().hasOnly(['id', 'url', 'isPrimary', 'caption']) &&
        item.id is string && item.id.size() >= 1 && item.id.size() <= 128 &&
        item.url is string && item.url.size() >= 1 && item.url.size() <= 800000 &&
        item.isPrimary is bool &&
        (!('caption' in item) || (item.caption is string && item.caption.size() <= 300));
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'businessName', 'tagline', 'whatsappNumber', 'email', 'address',
          'instagram', 'heroTitle', 'heroSubtitle', 'heroImageUrl',
          'logoText', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessName', 'tagline', 'whatsappNumber', 'email', 'address',
          'instagram', 'tiktok', 'heroTitle', 'heroSubtitle', 'heroImageUrl',
          'logoText', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
        data.tagline is string && data.tagline.size() <= 250 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 25 &&
        data.whatsappNumber.matches('^[0-9+]+$') &&
        data.email is string && data.email.size() <= 120 &&
        data.address is string && data.address.size() <= 300 &&
        data.instagram is string && data.instagram.size() <= 100 &&
        (!('tiktok' in data) || (data.tiktok is string && data.tiktok.size() <= 100)) &&
        data.heroTitle is string && data.heroTitle.size() >= 1 && data.heroTitle.size() <= 200 &&
        data.heroSubtitle is string && data.heroSubtitle.size() <= 400 &&
        data.heroImageUrl is string && data.heroImageUrl.size() >= 1 && data.heroImageUrl.size() <= 800000 &&
        data.logoText is string && data.logoText.size() >= 1 && data.logoText.size() <= 60 &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'name', 'slug', 'description', 'iconName', 'coverImageUrl',
          'sortOrder', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'slug', 'description', 'iconName', 'coverImageUrl',
          'sortOrder', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 &&
        data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.description is string && data.description.size() <= 300 &&
        data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 40 &&
        data.coverImageUrl is string && data.coverImageUrl.size() >= 1 && data.coverImageUrl.size() <= 800000 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name', 'category', 'price', 'priceLabel', 'shortDescription',
          'description', 'images', 'variants', 'inclusions', 'isAvailable',
          'isFeatured', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'category', 'price', 'originalPrice', 'priceLabel', 'shortDescription',
          'description', 'images', 'variants', 'sizes', 'inclusions', 'unit',
          'stockStatus', 'promoLabel', 'isPromo', 'isAvailable', 'isFeatured',
          'isNew', 'isActive', 'popularityScore', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.price is number && data.price >= 0 && data.price <= 10000000000 &&
        (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 10000000000)) &&
        data.priceLabel is string && data.priceLabel.size() <= 80 &&
        data.shortDescription is string && data.shortDescription.size() <= 300 &&
        data.description is string && data.description.size() <= 4000 &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 20 &&
        isValidImageItem(data.images[0]) &&
        data.variants is list && data.variants.size() <= 15 &&
        (data.variants.size() == 0 || (data.variants[0] is string && data.variants[0].size() <= 120)) &&
        (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 15 && (data.sizes.size() == 0 || (data.sizes[0] is string && data.sizes[0].size() <= 80)))) &&
        data.inclusions is list && data.inclusions.size() <= 20 &&
        (data.inclusions.size() == 0 || (data.inclusions[0] is string && data.inclusions[0].size() <= 200)) &&
        (!('unit' in data) || (data.unit is string && data.unit.size() <= 40)) &&
        (!('stockStatus' in data) || (data.stockStatus is string && data.stockStatus.size() <= 60)) &&
        (!('promoLabel' in data) || (data.promoLabel is string && data.promoLabel.size() <= 80)) &&
        (!('isPromo' in data) || data.isPromo is bool) &&
        data.isAvailable is bool &&
        data.isFeatured is bool &&
        (!('isNew' in data) || data.isNew is bool) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('popularityScore' in data) || (data.popularityScore is number && data.popularityScore >= 0 && data.popularityScore <= 1000000)) &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWeddingPackage(data) {
      return data.keys().hasAll([
          'name', 'tier', 'price', 'guestCapacity', 'description',
          'inclusions', 'images', 'isPopular', 'visibility',
          'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'tier', 'price', 'originalPrice', 'guestCapacity', 'description',
          'inclusions', 'images', 'isPopular', 'isPromo', 'promoLabel', 'isActive',
          'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.tier is string && data.tier.size() >= 1 && data.tier.size() <= 60 &&
        data.price is number && data.price >= 0 && data.price <= 10000000000 &&
        (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 10000000000)) &&
        data.guestCapacity is string && data.guestCapacity.size() <= 80 &&
        data.description is string && data.description.size() <= 2000 &&
        data.inclusions is list && data.inclusions.size() >= 1 && data.inclusions.size() <= 25 &&
        data.inclusions[0] is string && data.inclusions[0].size() <= 200 &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 20 &&
        isValidImageItem(data.images[0]) &&
        data.isPopular is bool &&
        (!('isPromo' in data) || data.isPromo is bool) &&
        (!('promoLabel' in data) || (data.promoLabel is string && data.promoLabel.size() <= 80)) &&
        (!('isActive' in data) || data.isActive is bool) &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll([
          'title', 'category', 'imageUrl', 'caption', 'aspectType',
          'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'imageUrl', 'caption', 'location', 'theme',
          'images', 'aspectType', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 800000 &&
        data.caption is string && data.caption.size() <= 400 &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('theme' in data) || (data.theme is string && data.theme.size() <= 120)) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 20 && (data.images.size() == 0 || isValidImageItem(data.images[0])))) &&
        data.aspectType in ['landscape', 'portrait', 'square'] &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll([
          'coupleName', 'eventDate', 'venue', 'packageTaken', 'rating',
          'review', 'images', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'coupleName', 'eventDate', 'venue', 'packageTaken', 'rating',
          'review', 'images', 'visibility', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.coupleName is string && data.coupleName.size() >= 1 && data.coupleName.size() <= 120 &&
        data.eventDate is string && data.eventDate.size() <= 80 &&
        data.venue is string && data.venue.size() <= 150 &&
        data.packageTaken is string && data.packageTaken.size() <= 150 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.review is string && data.review.size() >= 1 && data.review.size() <= 1500 &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 20 &&
        isValidImageItem(data.images[0]) &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPromo(data) {
      return data.keys().hasAll([
          'title', 'description', 'promoPrice', 'normalPrice', 'imageUrl',
          'startDate', 'endDate', 'isActive', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'description', 'promoPrice', 'normalPrice', 'imageUrl',
          'startDate', 'endDate', 'badgeText', 'isActive', 'visibility',
          'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.description is string && data.description.size() <= 1000 &&
        data.promoPrice is number && data.promoPrice >= 0 && data.promoPrice <= 10000000000 &&
        data.normalPrice is number && data.normalPrice >= 0 && data.normalPrice <= 10000000000 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 800000 &&
        data.startDate is string && data.startDate.size() <= 30 &&
        data.endDate is string && data.endDate.size() <= 30 &&
        (!('badgeText' in data) || (data.badgeText is string && data.badgeText.size() <= 60)) &&
        data.isActive is bool &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidArticle(data) {
      return data.keys().hasAll([
          'title', 'category', 'excerpt', 'content', 'imageUrl',
          'readTime', 'publishedDate', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'excerpt', 'content', 'imageUrl',
          'readTime', 'publishedDate', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.excerpt is string && data.excerpt.size() <= 400 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 8000 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 800000 &&
        data.readTime is string && data.readTime.size() <= 40 &&
        data.publishedDate is string && data.publishedDate.size() <= 60 &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCalendarPublic(data) {
      return data.keys().hasAll([
          'date', 'status', 'publicNote', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'date', 'status', 'publicNote', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.status in ['available', 'reserved', 'unavailable'] &&
        data.publicNote is string && data.publicNote.size() <= 200 &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCalendarPrivate(data) {
      return data.keys().hasAll([
          'date', 'clientName', 'privateNote', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'date', 'clientName', 'privateNote', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.clientName is string && data.clientName.size() <= 150 &&
        data.privateNote is string && data.privateNote.size() <= 500 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidServiceArea(data) {
      return data.keys().hasAll([
          'city', 'province', 'description', 'isPrimary', 'visibility',
          'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'city', 'province', 'description', 'isPrimary', 'visibility',
          'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 100 &&
        data.province is string && data.province.size() <= 100 &&
        data.description is string && data.description.size() <= 300 &&
        data.isPrimary is bool &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid == adminId && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll([
          'userId', 'coupleName', 'weddingLocation', 'cartWeddingDate',
          'cartGuestCount', 'cartItemsJson', 'wishlistIds',
          'weddingPlanJson', 'budgetAllocationJson', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'coupleName', 'weddingLocation', 'cartWeddingDate',
          'cartGuestCount', 'cartItemsJson', 'wishlistIds',
          'weddingPlanJson', 'budgetAllocationJson', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.coupleName is string && data.coupleName.size() <= 150 &&
        data.weddingLocation is string && data.weddingLocation.size() <= 250 &&
        data.cartWeddingDate is string && data.cartWeddingDate.size() <= 30 &&
        data.cartGuestCount is number && data.cartGuestCount >= 0 && data.cartGuestCount <= 50000 &&
        data.cartItemsJson is string && data.cartItemsJson.size() <= 200000 &&
        data.wishlistIds is list && data.wishlistIds.size() <= 200 &&
        data.weddingPlanJson is string && data.weddingPlanJson.size() <= 100000 &&
        data.budgetAllocationJson is string && data.budgetAllocationJson.size() <= 50000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInquiryDoc(data) {
      return data.keys().hasAll([
          'userId', 'type', 'customerDate', 'guestCount',
          'itemsSummary', 'totalEstimate', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'coupleName', 'weddingLocation', 'type',
          'customerDate', 'guestCount', 'itemsSummary', 'totalEstimate', 'createdAt'
        ]) &&
        data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
        (!('coupleName' in data) || (data.coupleName is string && data.coupleName.size() <= 150)) &&
        (!('weddingLocation' in data) || (data.weddingLocation is string && data.weddingLocation.size() <= 250)) &&
        data.type in ['cart', 'budget', 'planner', 'product', 'date', 'consultation'] &&
        data.customerDate is string && data.customerDate.size() <= 60 &&
        data.guestCount is number && data.guestCount >= 0 && data.guestCount <= 50000 &&
        data.itemsSummary is list && data.itemsSummary.size() <= 100 &&
        (data.itemsSummary.size() == 0 || (data.itemsSummary[0] is string && data.itemsSummary[0].size() <= 250)) &&
        data.totalEstimate is number && data.totalEstimate >= 0 && data.totalEstimate <= 100000000000 &&
        data.createdAt is timestamp;
    }

    function isValidConsultationSession(data, userId, consultationId) {
      return data.keys().hasAll([
          'consultationId', 'userId', 'title', 'coupleName', 'weddingDate',
          'weddingLocation', 'guestCount', 'targetBudget', 'weddingTheme',
          'desiredColors', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'consultationId', 'userId', 'title', 'coupleName', 'weddingDate',
          'weddingLocation', 'guestCount', 'targetBudget', 'weddingTheme',
          'desiredColors', 'createdAt', 'updatedAt'
        ]) &&
        data.consultationId is string && data.consultationId == consultationId && data.consultationId.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.coupleName is string && data.coupleName.size() <= 150 &&
        data.weddingDate is string && data.weddingDate.size() <= 30 &&
        data.weddingLocation is string && data.weddingLocation.size() <= 250 &&
        data.guestCount is number && data.guestCount >= 0 && data.guestCount <= 50000 &&
        data.targetBudget is number && data.targetBudget >= 0 && data.targetBudget <= 100000000000 &&
        data.weddingTheme is string && data.weddingTheme.size() <= 150 &&
        data.desiredColors is string && data.desiredColors.size() <= 150 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsultationMessage(data, userId, consultationId, messageId) {
      return data.keys().hasAll([
          'messageId', 'consultationId', 'userId', 'sender', 'message',
          'recommendedProductIds', 'recommendationsJson', 'budgetBreakdownJson', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'messageId', 'consultationId', 'userId', 'sender', 'message',
          'recommendedProductIds', 'recommendationsJson', 'budgetBreakdownJson', 'createdAt'
        ]) &&
        data.messageId is string && data.messageId == messageId && data.messageId.size() <= 128 &&
        data.consultationId is string && data.consultationId == consultationId && data.consultationId.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid && data.userId.size() <= 128 &&
        data.sender in ['user', 'consultant'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 6000 &&
        data.recommendedProductIds is list && data.recommendedProductIds.size() <= 10 &&
        (data.recommendedProductIds.size() == 0 || (data.recommendedProductIds[0] is string && data.recommendedProductIds[0].size() <= 128)) &&
        data.recommendationsJson is string && data.recommendationsJson.size() <= 20000 &&
        data.budgetBreakdownJson is string && data.budgetBreakdownJson.size() <= 30000 &&
        data.createdAt is timestamp;
    }

    function isValidLeadDoc(data, leadId) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'partnerName', 'coupleName',
          'whatsapp', 'email', 'weddingDate', 'weddingLocation', 'eventType',
          'guestCount', 'budget', 'needs', 'interestedProductIds',
          'interestedProductNames', 'recommendedPackageNames',
          'consultationSummary', 'notes', 'status', 'source', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'consultationId', 'customerName', 'partnerName', 'coupleName',
          'whatsapp', 'email', 'weddingDate', 'weddingLocation', 'eventType',
          'guestCount', 'budget', 'needs', 'interestedProductIds',
          'interestedProductNames', 'recommendedPackageNames',
          'consultationSummary', 'notes', 'status', 'source', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == leadId && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        (!('consultationId' in data) || (data.consultationId is string && data.consultationId.size() <= 128)) &&
        data.customerName is string && data.customerName.size() <= 120 &&
        data.partnerName is string && data.partnerName.size() <= 120 &&
        data.coupleName is string && data.coupleName.size() <= 150 &&
        data.whatsapp is string && data.whatsapp.size() <= 30 &&
        data.email is string && data.email.size() <= 120 &&
        data.weddingDate is string && data.weddingDate.size() <= 40 &&
        data.weddingLocation is string && data.weddingLocation.size() <= 250 &&
        data.eventType is string && data.eventType.size() <= 120 &&
        data.guestCount is number && data.guestCount >= 0 && data.guestCount <= 50000 &&
        data.budget is number && data.budget >= 0 && data.budget <= 100000000000 &&
        data.needs is list && data.needs.size() <= 30 &&
        data.interestedProductIds is list && data.interestedProductIds.size() <= 50 &&
        data.interestedProductNames is list && data.interestedProductNames.size() <= 50 &&
        data.recommendedPackageNames is list && data.recommendedPackageNames.size() <= 20 &&
        data.consultationSummary is string && data.consultationSummary.size() <= 5000 &&
        data.notes is string && data.notes.size() <= 3000 &&
        data.status in ['New', 'Consultation', 'Interested', 'Follow Up', 'Booking', 'Completed', 'Cancelled'] &&
        data.source in ['consultation', 'planner', 'cart', 'catalog'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrderDoc(data, orderId) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'customerName', 'partnerName',
          'whatsapp', 'email', 'weddingDate', 'weddingLocation', 'eventType',
          'guestCount', 'itemsJson', 'totalAmount', 'status', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'leadId', 'consultationId',
          'customerName', 'partnerName', 'whatsapp', 'email', 'weddingDate',
          'weddingLocation', 'eventType', 'guestCount', 'itemsJson',
          'totalAmount', 'status', 'notes', 'paymentProofUrl',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == orderId && data.id.size() <= 128 &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 60 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        (!('leadId' in data) || (data.leadId is string && data.leadId.size() <= 128)) &&
        (!('consultationId' in data) || (data.consultationId is string && data.consultationId.size() <= 128)) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.partnerName is string && data.partnerName.size() <= 120 &&
        data.whatsapp is string && data.whatsapp.size() >= 5 && data.whatsapp.size() <= 30 &&
        data.email is string && data.email.size() <= 120 &&
        data.weddingDate is string && data.weddingDate.size() <= 40 &&
        data.weddingLocation is string && data.weddingLocation.size() <= 250 &&
        data.eventType is string && data.eventType.size() <= 120 &&
        data.guestCount is number && data.guestCount >= 0 && data.guestCount <= 50000 &&
        data.itemsJson is string && data.itemsJson.size() >= 2 && data.itemsJson.size() <= 100000 &&
        data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 100000000000 &&
        data.status in ['Pending', 'Confirmed', 'DP Paid', 'In Progress', 'Completed', 'Cancelled'] &&
        data.notes is string && data.notes.size() <= 3000 &&
        (!('paymentProofUrl' in data) || (data.paymentProofUrl is string && data.paymentProofUrl.size() <= 800000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

