        "source": {
          "type": "string",
          "enum": ["consultation", "planner", "cart", "catalog"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "customerName",
        "partnerName",
        "coupleName",
        "whatsapp",
        "email",
        "weddingDate",
        "weddingLocation",
        "eventType",
        "guestCount",
        "budget",
        "needs",
        "interestedProductIds",
        "interestedProductNames",
        "recommendedPackageNames",
        "consultationSummary",
        "notes",
        "status",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "WeddingOrderDoc": {
      "title": "WeddingOrderDoc",
      "description": "Customer wedding product and package booking order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
