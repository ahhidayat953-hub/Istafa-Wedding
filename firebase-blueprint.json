  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Global website settings."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Public catalog categories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public wedding products."
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/WeddingPackage" },
      "description": "Public wedding packages."
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Public wedding gallery projects."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Public client wedding testimonials."
    },
    "/promos/{promoId}": {
      "schema": { "$ref": "#/entities/Promo" },
      "description": "Public wedding promotional offers."
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/InspirationArticle" },
      "description": "Public wedding inspiration articles."
    },
    "/calendar/{dateId}": {
      "schema": { "$ref": "#/entities/CalendarPublicEntry" },
      "description": "Public wedding date availability status."
    },
    "/calendarPrivate/{dateId}": {
      "schema": { "$ref": "#/entities/CalendarPrivateEntry" },
      "description": "Admin-only private booking notes and client names."
    },
    "/serviceAreas/{areaId}": {
      "schema": { "$ref": "#/entities/ServiceArea" },
      "description": "Public service coverage areas."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role lookup records."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Private per-user cart, wishlist, wedding plan, and budget calculator."
    },
    "/users/{userId}/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/ConsultationSessionDoc" },
      "description": "Private per-user wedding consultation sessions."
    },
    "/users/{userId}/consultations/{consultationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConsultationMessageDoc" },
      "description": "Private per-user wedding consultation messages."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ConsultationInquiryDoc" },
      "description": "Consultation inquiry records."
    },
